{
  "name": "delegate",
  "version": "0.2.42",
  "description": "An AI stand-in that drafts and answers your chat messages while you are away.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "delegate": "src/cli.ts"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=4 test/*.test.ts && npm run test:react",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/react",
    "typecheck:test": "tsc --noEmit -p test",
    "golden": "node scripts/card-golden.ts && node scripts/report-golden.ts",
    "test:react": "vitest run",
    "trace": "node scripts/trace.ts",
    "build": "node scripts/build.ts",
    "eval:real": "DELEGATE_LOCAL=$(mktemp -d) scripts/limit.sh 1800 node scripts/eval.ts",
    "release": "node scripts/release.ts",
    "publish:github": "node scripts/publish.ts --to https://github.com/jpsahoo14/delegate.git",
    "publish:check": "node scripts/publish.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.0",
    "playwright-core": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "author": "jpsahoo14",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpsahoo14/delegate.git"
  },
  "homepage": "https://github.com/jpsahoo14/delegate#readme",
  "bugs": {
    "url": "https://github.com/jpsahoo14/delegate/issues"
  }
}
