{
  "compilerOptions": {
    "target": "es2023", "module": "nodenext", "moduleResolution": "nodenext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "skipLibCheck": true,
    "lib": ["es2023"], "types": ["node"]
  },
  "include": ["src", "scripts"],
  "exclude": ["src/web/app"]
}
